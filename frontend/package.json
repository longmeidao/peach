{
  "name": "peach-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:react": "vite build -c vite.react.config.ts --watch",
    "build": "vite build && vite build -c vite.react.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/react",
    "lint": "oxlint -c .oxlintrc.json src/react",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --test --test-concurrency=1 --test-reporter=tap \"e2e/**/*.test.ts\""
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "d3-sankey": "0.12.3",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-sankey": "0.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.83.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
