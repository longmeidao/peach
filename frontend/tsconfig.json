{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    // 配置文件之间按 Vite 8 的要求带 .ts 后缀互相 import；不产出 JS，所以允许。
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    "paths": {
      "@peach/legacy/core": ["./src/legacy/core.d.ts"],
      "@peach/legacy/ui": ["./src/legacy/ui.d.ts"],
      "@peach/react": ["./src/react/bundle.d.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "vite.react.config.ts", "vitest.config.ts"],
  // React 子树按 React JSX 检查，入口是 src/react/tsconfig.json（`npm run typecheck` 两份都跑）。
  "exclude": ["src/react", "test/react"]
}
